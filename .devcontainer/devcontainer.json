{
    "name": "Hogwarts DB - Rust, SQLite, MongoDB & NASM Environment (Compose)",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "runServices": [
        "app",
        "db"
    ],
    "workspaceFolder": "/workspaces/starter-2025",

    "features": {
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "latest",
            "profile": "default"
        },
        "ghcr.io/devcontainers/features/common-utils:1": {}
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh && bash .devcontainer/health-check.sh",
    "forwardPorts": [
        27017
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "serayuzgur.crates",
                "mongodb.mongodb-vscode",
                "13xforever.language-x86-64-assembly",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-sqlite"
            ],
            "settings": {
                "rust-analyzer.checkOnSave.command": "check",
                "editor.formatOnSave": true
            }
        }
    },

    "remoteUser": "vscode"
}
