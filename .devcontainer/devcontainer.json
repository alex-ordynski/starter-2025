{
    "name": "Hogwarts DB - Rust, SQLite & NASM Environment",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/rust:1": {},
        "ghcr.io/warrenbuckley/codespace-features/sqlite:latest": {},
        "ghcr.io/devcontainers/features/common-utils:1": {}
    },

    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y nasm curl gdb gcc-multilib && printf '.mode table\\n.headers on\\n' > ~/.sqliterc && sqlite3 hogwarts.db < setup.sql",

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "serayuzgur.crates"
            ],
            "settings": {
                "rust-analyzer.checkOnSave.command": "check",
                "editor.formatOnSave": true
            }
        }
    },

    "remoteUser": "vscode"
}
