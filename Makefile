# =============================================================================
# Універсальний Makefile для 32-бітних програм NASM (ELF32 / i386)
# =============================================================================

# -- Інструменти --
ASM = nasm
LD = ld

# -- Прапорці --
# -f elf32: Формат файлу (Executable and Linkable Format, 32-bit)
# -g: Додати відлагоджувальну інформацію
# -F dwarf: Формат відлагоджувальної інформації (для gdb)
ASFLAGS = -f elf32 -g -F dwarf

# -m elf_i386: Вказати компонувальнику, що ми створюємо 32-бітний файл
LDFLAGS = -m elf_i386

# -- Визначення файлів --
# Знайти всі файли з розширенням .asm у поточній директорії
SOURCES = $(wildcard *.asm)
# Створити список імен виконуваних файлів, замінивши .asm на порожній рядок
EXECUTABLES = $(SOURCES:.asm=)

# -- Правила збірки --

# Ціль за замовчуванням: зібрати всі виконувані файли
all: $(EXECUTABLES)

# Шаблонне правило: як створити виконуваний файл (%) з .asm файлу (%.asm)
# $< - це ім'я першої залежності (вихідний .asm файл)
# $@ - це ім'я цілі (виконуваний файл)
%: %.asm
	$(ASM) $(ASFLAGS) -o $@.o $<
	$(LD) $(LDFLAGS) -o $@ $@.o
	@echo "Зібрано: $@"

# Ціль для очищення: видаляє всі згенеровані файли
clean:
	@echo "Очищення..."
	rm -f *.o $(EXECUTABLES)
	@echo "Готово."

# Позначаємо 'all' та 'clean' як фіктивні цілі
.PHONY: all clean
